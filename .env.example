# ==============================================
# AI Voice Copilot - Environment Configuration
# ==============================================

# --- LLM Provider API Keys ---
# Google Gemini (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (Free tier available at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Cerebras (Free tier available at https://cloud.cerebras.ai/)
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Local Ollama endpoint (optional fallback)
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Default LLM Mode Assignments ---
# Fast Mode: Low-latency inference (Groq / Cerebras)
DEFAULT_FAST_PROVIDER=groq
DEFAULT_FAST_MODEL=llama-3.1-8b-instant

# Reasoning Mode: High accuracy and deep reasoning (Gemini / Cerebras Llama 70B)
DEFAULT_REASONING_PROVIDER=gemini
DEFAULT_REASONING_MODEL=gemini-2.0-flash

# Research Mode: Complex multi-source analysis
DEFAULT_RESEARCH_PROVIDER=groq
DEFAULT_RESEARCH_MODEL=llama-3.3-70b-versatile

# --- LLM Routing & Fallback ---
ENABLE_AUTO_ROUTING=true
LLM_REQUEST_TIMEOUT_SECS=30
MAX_CONCURRENT_LLM_REQUESTS=5
ENABLE_FALLBACK=true

# --- Audio Capture & STT ---
AUDIO_CAPTURE_MODE=system
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_BUFFER_MS=30
STT_PROVIDER=whisper-local
STT_MODEL_SIZE=base
STT_LANGUAGE=en
STT_DEVICE=cpu

# --- Backend Server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_WORKERS=1

# --- Database & Persistence ---
DATABASE_URL=sqlite+aiosqlite:///storage/database/app.db

# --- Vector Store & Embeddings ---
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=storage/vector-store
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Document Processing & RAG ---
MAX_DOCUMENT_SIZE_MB=50
SUPPORTED_FORMATS=txt,pdf,doc,docx
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# --- Getscreen.me Remote Session (Optional) ---
GETSCREEN_API_KEY=
GETSCREEN_ENABLED=false

# --- Security ---
SECRET_KEY=change-this-to-a-random-32-byte-hex-secret
API_KEY_ENCRYPTION_KEY=wG5iN9qWcW9t6uW-4uK-5H5T4V_w5O-0Y8_Z9L8_M6c=

# --- Logging & Monitoring ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FORMAT=json
ENABLE_METRICS=true
METRICS_EXPORT_INTERVAL_SECS=60

# --- WebSockets ---
WEBSOCKET_PING_INTERVAL=30
WEBSOCKET_MAX_CONNECTIONS=10

# --- gRPC (Rust Audio Engine <-> Python Backend) ---
GRPC_HOST=127.0.0.1
GRPC_PORT=50051
